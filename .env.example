# Deterministic local development (default)
MACHINEFI_DATA_MODE=fixture
MACHINEFI_HOST=127.0.0.1
MACHINEFI_PORT=8787

# Production application (uncomment the required values for your deployment)
# MACHINEFI_DATA_MODE=production
# MACHINEFI_DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# MACHINEFI_ALLOW_LIVE=1
# MACHINEFI_SOLANA_RPC_URL=https://operator-owned-rpc.example
# MACHINEFI_SOLANA_CLUSTER=mainnet-beta
# Known mainnet-beta/devnet/testnet labels use canonical pinned genesis hashes.
# Only a custom cluster requires the explicit verified getGenesisHash result:
# MACHINEFI_SOLANA_GENESIS_HASH=<required-when-MACHINEFI_SOLANA_CLUSTER=custom>
# MACHINEFI_PUBLIC_ORIGIN=https://console.example.com
# MACHINEFI_HOST=10.0.0.25
# Managed web services that require 0.0.0.0 may set both values below. This is
# accepted only in production mode with the HTTPS/public-origin checks active.
# MACHINEFI_HOST=0.0.0.0
# MACHINEFI_ALLOW_PUBLIC_BIND=true
# MACHINEFI_SECURE_COOKIES=1
# MACHINEFI_TELEMETRY_RETENTION_DAYS=30
# MACHINEFI_TELEMETRY_MAX_EVENTS_PER_MACHINE=10000
